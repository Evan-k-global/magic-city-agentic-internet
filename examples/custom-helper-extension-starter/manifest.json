{
  "manifest_version": 3,
  "name": "Acme Magic City Helper",
  "version": "0.3.0",
  "description": "Read-only starter for mission-scoped Magic City browser execution.",
  "permissions": ["storage", "tabs", "scripting"],
  "optional_host_permissions": ["https://example.com/*"],
  "host_permissions": ["https://magic-city.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
